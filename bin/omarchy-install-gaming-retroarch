#!/bin/bash

# omarchy:summary=Install RetroArch with every libretro core Ubuntu packages plus a ~/Games ROM directory.
# omarchy:requires-sudo=true

set -e

echo "Installing RetroArch..."

# These are all the libretro-* core packages in stonking (universe and
# multiverse) as of 2026-10-10; Arch's fuller core set, the overlays, the slang
# shaders, the database and the joypad autoconfig profiles have no Ubuntu
# packages. RetroArch's own Online Updater fetches those into
# ~/.config/retroarch once it is running.
omarchy-pkg-add \
  retroarch retroarch-assets libretro-core-info \
  libretro-beetle-pce-fast libretro-beetle-psx libretro-beetle-vb libretro-beetle-wswan \
  libretro-bsnes-mercury-accuracy libretro-bsnes-mercury-balanced libretro-bsnes-mercury-performance \
  libretro-desmume \
  libretro-gambatte libretro-genesisplusgx \
  libretro-mgba \
  libretro-nestopia \
  libretro-sameboy libretro-snes9x

# Set up ~/Games for BIOS files and ROMs
mkdir -p "$HOME/Games/bios" "$HOME/Games/roms"

CFG="$HOME/.config/retroarch/retroarch.cfg"
mkdir -p "$(dirname "$CFG")"
touch "$CFG"

set_cfg() {
  local key=$1 value=$2
  if grep -q "^$key = " "$CFG"; then
    sed -i "s|^$key = .*|$key = \"$value\"|" "$CFG"
  else
    echo "$key = \"$value\"" >>"$CFG"
  fi
}

set_cfg rgui_browser_directory "$HOME/Games/roms"
set_cfg system_directory "$HOME/Games/bios"

# Point at the cores, core info and assets installed by apt (paths from the
# stonking Contents index for libretro-*, libretro-core-info and retroarch-assets).
set_cfg libretro_directory "/usr/lib/x86_64-linux-gnu/libretro"
set_cfg libretro_info_path "/usr/share/libretro/info"
set_cfg assets_directory "/usr/share/libretro/assets"

# Vulkan is required for slang shaders and unlocks hardware renderers in beetle-psx
set_cfg video_driver "vulkan"

# XMB is the classic PS3-style menu (vs. ozone/rgui/glui)
set_cfg menu_driver "xmb"

# Hide Images and Video tabs in the main menu sidebar
set_cfg content_show_images "false"
set_cfg content_show_video "false"

echo ""
echo "Put your roms and bios files in ~/Games. Then start RetroArch from the app launcher (Super + Space)."
echo "Inside RetroArch, run Online Updater to fetch shaders, overlays, the database and joypad profiles."

setsid nautilus "$HOME/Games" >/dev/null 2>&1 &
