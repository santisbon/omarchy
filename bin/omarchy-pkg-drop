#!/bin/bash

# omarchy:summary=Remove all the named packages from the system if they're installed (otherwise ignore).
# omarchy:args=<packages...>
# omarchy:requires-sudo=true

installed=()
declare -A selected=()

for pkg in "$@"; do
  [[ -z ${selected[$pkg]} ]] || continue
  if [[ $(dpkg-query -W -f='${db:Status-Status}' "$pkg" 2>/dev/null) == "installed" ]]; then
    installed+=("$pkg")
    selected[$pkg]=1
  fi
done

if (( ${#installed[@]} > 0 )); then
  # purge drops the package's configuration with it, and --autoremove takes the
  # dependencies apt installed only for it. A package the desktop meta package
  # depends on takes the meta package with it; apt says so before acting.
  sudo apt-get purge -y --autoremove "${installed[@]}"
fi
