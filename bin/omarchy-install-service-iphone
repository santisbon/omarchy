#!/bin/bash

# omarchy:summary=Install iphonebridge, pair the iPhone, and set up its messages, contacts, notifications and calls, with the daemon confined by AppArmor.
# omarchy:requires-sudo=true

set -euo pipefail

# What the user has to do is yellow; everything else is information they can let scroll by.
action() { echo -e "\e[33m$*\e[0m"; }

echo "This sets up your iPhone's messages, contacts, notifications, calls and media controls."
action "Keep the iPhone unlocked and nearby until this finishes.\n"

# iphonebridge comes from Oaxaca's repository, which publishes the project's release .deb unchanged.
# Its package installs the daemon's AppArmor profile; oFono carries the calls.
omarchy-pkg-add iphonebridge ofono wl-clipboard ibus-data fonts-noto-color-emoji
# The wait at the end asks the daemon for calls and media control, which it reports from 0.20.4 on,
# and from 0.20.5 on the daemon picks oFono up again after oFono restarts; omarchy-pkg-add leaves an
# installed older version as it is.
if dpkg --compare-versions "$(dpkg-query -W -f='${Version}' iphonebridge)" lt 0.20.5; then
  sudo apt-get install -y --only-upgrade iphonebridge
fi

# The app launcher shows the menu's phone glyph for the iPhone app: an icon in the user's icon
# theme takes precedence over the one iphonebridge installs in /usr/share/icons.
install -D -m 0644 "$OMARCHY_PATH/default/iphone/iphone.svg" \
  "$HOME/.local/share/icons/hicolor/scalable/apps/me.santisbon.iphonebridge.UI.svg"

# Per-app notifications need BlueZ's experimental PreferredBearer control. A drop-in turns it on
# with bluetoothd's -E flag, so BlueZ's own /etc/bluetooth/main.conf stays as the package ships it.
# -E also turns on BlueZ's own Hands-Free client (the plugin "hfp", experimental in BlueZ 5.87),
# which connects to the iPhone by itself and takes the Hands-Free link oFono needs for calls.
dropin=/etc/systemd/system/bluetooth.service.d/iphonebridge.conf
want=$'[Service]\nExecStart=\nExecStart=/usr/libexec/bluetooth/bluetoothd -E --noplugin=hfp'
if [[ $(cat "$dropin" 2>/dev/null) != "$want" ]]; then
  echo -e "\nTurning on BlueZ's experimental interfaces..."
  echo "Bluetooth restarts: other Bluetooth devices disconnect for up to a minute."
  # Bluetooth keyboards and mice, as "<address> <icon> <name>" lines, <icon> being BlueZ's
  # input-keyboard, input-mouse and the like. The pairing below needs the keyboard to confirm the
  # iPhone's code before the iPhone gives up, and a Bluetooth keyboard reconnected after the restart
  # on 2026-10-27 only once a key was pressed on it.
  inputs=()
  while read -r _ input_address input_name; do
    input_icon=$(bluetoothctl info "$input_address" | sed -n 's/^[[:space:]]*Icon: \(input-.*\)/\1/p')
    [[ -n $input_icon ]] && inputs+=("$input_address $input_icon $input_name")
  done < <(bluetoothctl devices Connected 2>/dev/null)
  sudo mkdir -p "${dropin%/*}"
  printf '%s\n' "$want" | sudo tee "$dropin" >/dev/null
  sudo systemctl daemon-reload
  sudo systemctl restart bluetooth
  sleep 2
  for input in "${inputs[@]}"; do
    read -r input_address input_icon input_name <<<"$input"
    case $input_icon in
      input-keyboard) action "Press a key on $input_name so it reconnects." ;;
      input-mouse | input-tablet) action "Move $input_name so it reconnects." ;;
      *) action "Use $input_name so it reconnects." ;;
    esac
    echo "Waiting up to a minute for $input_name..."
    for (( waited = 0; waited < 60; waited++ )); do
      bluetoothctl devices Connected 2>/dev/null | grep -q "^Device $input_address " && break
      sleep 1
    done
  done
fi

# Calls: WirePlumber hands the Hands-Free profile to oFono, and oFono has to start after
# WirePlumber to claim it. oFono 2.19 aborted (SIGABRT) right after finding the iPhone's modem on
# 2026-10-27, and Ubuntu's unit doesn't restart it, so a drop-in does.
echo -e "\nSetting up calls..."
iphonebridge hfp-enable >/dev/null
ofono_dropin=/etc/systemd/system/ofono.service.d/iphonebridge.conf
ofono_want=$'[Service]\nRestart=on-failure\nRestartSec=2'
if [[ $(cat "$ofono_dropin" 2>/dev/null) != "$ofono_want" ]]; then
  sudo mkdir -p "${ofono_dropin%/*}"
  printf '%s\n' "$ofono_want" | sudo tee "$ofono_dropin" >/dev/null
  sudo systemctl daemon-reload
fi
sudo systemctl enable ofono >/dev/null 2>&1
sudo systemctl restart ofono

# iOS reads the computer's class and the daemon's Low Energy advertisement when it pairs, and
# offers the message, contacts and notification toggles only if both were there. The daemon sets
# both when it starts, even before it knows the iPhone.
systemctl --user restart iphonebridge

# Paired phones, one "<address> <name>" line each.
paired_phones() {
  local address name
  while read -r _ address name; do
    bluetoothctl info "$address" | grep -q 'Icon: phone' && echo "$address $name"
  done < <(bluetoothctl devices Paired)
}

# Per-app notifications need the bond's Low Energy keys, which BlueZ records in the bond's
# SupportedTechnologies. Only root can read the bond.
has_le_keys() {
  local adapter
  adapter=$(bluetoothctl show | sed -n 's/^Controller \([0-9A-F:]*\).*/\1/p' | head -1)
  sudo grep -q '^SupportedTechnologies=.*LE' "/var/lib/bluetooth/$adapter/$1/info" 2>/dev/null
}

mapfile -t phones < <(paired_phones)
address=""
if (( ${#phones[@]} == 1 )); then
  address=${phones[0]%% *}
elif (( ${#phones[@]} > 1 )); then
  choice=$(printf '%s\n' "${phones[@]}" | gum choose --header "Which phone is the iPhone?") || exit 1
  address=${choice%% *}
fi

if [[ -n $address ]] && ! has_le_keys "$address"; then
  echo -e "\nThe iPhone's pairing has no Low Energy keys, so per-app notifications can't work with it."
  if gum confirm "Pair the iPhone again?"; then
    bluetoothctl remove "$address" >/dev/null
    address=""
  fi
fi

if [[ -z $address ]]; then
  name=$(bluetoothctl show | sed -n 's/^[[:space:]]*Alias: //p' | head -1)
  action "\nOn the iPhone, open Settings > Bluetooth. If \"$name\" is under My Devices, tap the (i) next to it and"
  action "tap Forget This Device. Then tap \"$name\" under Other Devices and confirm the code on both screens."
  echo "The pairing has to start on the iPhone: that is what gives it the Low Energy keys notifications need."
  echo -e "\nWaiting up to 5 minutes for the iPhone to pair..."
  result=$(mktemp)
  trap 'rm -f "$result"' EXIT
  # A Bluetooth agent for this one pairing, since the desktop runs none: it confirms the code
  # with gum, accepts the iPhone's services, trusts the iPhone, and writes its address to $result.
  python3 -c '
import subprocess, sys
import dbus, dbus.service, dbus.mainloop.glib
from gi.repository import GLib

dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
bus = dbus.SystemBus()
loop = GLib.MainLoop()
path = "/iphonebridge/pairing_agent"

def props(obj):
    return dbus.Interface(bus.get_object("org.bluez", obj), "org.freedesktop.DBus.Properties")

class Rejected(dbus.DBusException):
    _dbus_error_name = "org.bluez.Error.Rejected"

class Agent(dbus.service.Object):
    @dbus.service.method("org.bluez.Agent1", in_signature="ou", out_signature="")
    def RequestConfirmation(self, device, passkey):
        alias = props(device).Get("org.bluez.Device1", "Alias")
        if subprocess.run(["gum", "confirm", f"Does {alias} show the code {passkey:06d}?"]).returncode:
            raise Rejected("the codes differ")

    @dbus.service.method("org.bluez.Agent1", in_signature="o", out_signature="")
    def RequestAuthorization(self, device):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="os", out_signature="")
    def AuthorizeService(self, device, uuid):
        pass

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Cancel(self):
        print("The iPhone cancelled the pairing.")

    @dbus.service.method("org.bluez.Agent1", in_signature="", out_signature="")
    def Release(self):
        pass

objects = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
adapter = next(p for p, i in objects.items() if "org.bluez.Adapter1" in i)
before = {p for p, i in objects.items() if i.get("org.bluez.Device1", {}).get("Paired")}

def changed(iface, values, _invalidated, path=None):
    if iface == "org.bluez.Device1" and values.get("Paired") and path not in before:
        props(path).Set("org.bluez.Device1", "Trusted", dbus.Boolean(True))
        with open(sys.argv[1], "w") as f:
            f.write(str(props(path).Get("org.bluez.Device1", "Address")))
        loop.quit()

bus.add_signal_receiver(changed, "PropertiesChanged", "org.freedesktop.DBus.Properties",
                        "org.bluez", path_keyword="path")
Agent(bus, path)
manager = dbus.Interface(bus.get_object("org.bluez", "/org/bluez"), "org.bluez.AgentManager1")
manager.RegisterAgent(path, "DisplayYesNo")
manager.RequestDefaultAgent(path)
adapter_props = props(adapter)
adapter_props.Set("org.bluez.Adapter1", "Pairable", dbus.Boolean(True))
adapter_props.Set("org.bluez.Adapter1", "Discoverable", dbus.Boolean(True))
GLib.timeout_add_seconds(300, loop.quit)
try:
    loop.run()
finally:
    # Right after a pairing, BlueZ answers Busy while the iPhone is still connecting;
    # the shell turns discoverable mode off once this helper is done.
    for call in (lambda: adapter_props.Set("org.bluez.Adapter1", "Discoverable", dbus.Boolean(False)),
                 lambda: manager.UnregisterAgent(path)):
        try:
            call()
        except dbus.DBusException:
            pass
' "$result"
  bluetoothctl discoverable off >/dev/null 2>&1 || true
  address=$(cat "$result")
  [[ -n $address ]] || { echo "The iPhone didn't pair within 5 minutes. Run Install > Service > iPhone again." >&2; exit 1; }
  # BlueZ stores the Low Energy keys a moment after the pairing itself.
  for (( waited = 0; waited < 10; waited++ )); do
    has_le_keys "$address" && break
    sleep 1
  done
  has_le_keys "$address" || echo -e "\nThe pairing has no Low Energy keys: messages, contacts and calls work, per-app notifications won't." >&2
fi

# What iphonebridge pair-setup writes: the iPhone's address, readable only by the user.
mkdir -p "$HOME/.config/iphonebridge"
(umask 077 && echo "IPHONEBRIDGE_MAC=$address" >"$HOME/.config/iphonebridge/local.env")
bluetoothctl trust "$address" >/dev/null

# Per-app notifications travel over Bluetooth Low Energy: ancs-enable reconnects the iPhone over it.
enable_notifications() {
  iphonebridge ancs-enable >/dev/null 2>&1 || true
}

# ancs-enable leaves the iPhone on Bluetooth Low Energy, and the iPhone's classic Bluetooth
# services (Hands-Free for calls, AV Remote Control for media) can be missing from BlueZ's record of
# the iPhone: BlueZ aborted its service search during a pairing ("error updating services"). A
# classic Bluetooth connection with PreferredBearer set to bredr makes BlueZ search for them. When
# the iPhone is already connected over classic Bluetooth, that connection does nothing, so the two
# profiles on the iPhone, Hands-Free Audio Gateway and AV Remote Control, are connected by name.
# PreferredBearer goes back to le for per-app notifications.
connect_classic() {
  python3 - "$address" <<'PYTHON' || true
import sys
import dbus

bus = dbus.SystemBus()
objects = dbus.Interface(bus.get_object("org.bluez", "/"), "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
path = next(p for p, i in objects.items() if str(i.get("org.bluez.Device1", {}).get("Address", "")) == sys.argv[1])
props = dbus.Interface(bus.get_object("org.bluez", path), "org.freedesktop.DBus.Properties")
device = dbus.Interface(bus.get_object("org.bluez", path), "org.bluez.Device1")
props.Set("org.bluez.Device1", "PreferredBearer", "bredr")
try:
    for connect in (lambda: device.Connect(timeout=60),
                    lambda: device.ConnectProfile("0000111f-0000-1000-8000-00805f9b34fb", timeout=30),
                    lambda: device.ConnectProfile("0000110e-0000-1000-8000-00805f9b34fb", timeout=30)):
        try:
            connect()
        except dbus.DBusException:
            pass
finally:
    props.Set("org.bluez.Device1", "PreferredBearer", "le")
PYTHON
}

echo -e "\nConnecting to the iPhone. This can take up to 3 minutes..."
enable_notifications
connect_classic
sleep 5
systemctl --user restart iphonebridge
# The unit is Type=simple, so systemctl restart returns before the new process
# has executed the daemon; until then the process is still systemd's, unconfined.
for (( waited = 0; waited < 10; waited++ )); do
  label=$(cat "/proc/$(systemctl --user show -p MainPID --value iphonebridge.service)/attr/current" 2>/dev/null || true)
  [[ $label != "iphonebridge (enforce)" ]] || break
  sleep 1
done
if [[ $label != "iphonebridge (enforce)" ]]; then
  echo -e "\nThe iPhone daemon is not running under its AppArmor profile (label: ${label:-none})." >&2
  exit 1
fi

computer=$(bluetoothctl show | sed -n 's/^[[:space:]]*Alias: //p' | head -1)
action "\nOn the iPhone, in Settings > Bluetooth, tap the (i) next to \"$computer\" and turn on"
action "Show Message Notifications, Sync Contacts and Share System Notifications."
echo "Some of the toggles can take a minute to appear: if you see only one, wait for the others."

# The features the daemon reports as working, from its GetStatus answer: a space-separated list
# of map (messages), pbap (contacts), ancs (per-app notifications), hfp (calls) and avrcp (media).
working() {
  busctl --user --json=short call me.santisbon.iphonebridge /me/santisbon/iphonebridge \
    me.santisbon.iphonebridge.Messages1 GetStatus 2>/dev/null |
    python3 -c 'import json, sys; s = json.loads(json.load(sys.stdin)["data"][0]); print(" ".join(k for k, v in s.items() if v))' 2>/dev/null || true
}

# The installer finishes only when everything works. Messages and contacts wait for the iPhone's
# toggles. Once both work, the toggles are on, and a minute without notifications, calls or media
# control gets the connection that brings them up again.
echo -e "\nWaiting for each feature to work. Messages and contacts start once their"
echo "toggles take effect on the iPhone, which can take a few minutes."
features=("map:Messages" "pbap:Contacts" "ancs:Per-app notifications" "hfp:Calls" "avrcp:Media controls")
declare -A reported=()
started=$SECONDS
last_fix=$SECONDS
next_report=60
while true; do
  up=" $(working) "
  missing=()
  for feature in "${features[@]}"; do
    key=${feature%%:*} name=${feature#*:}
    if [[ $up == *" $key "* ]]; then
      [[ -n ${reported[$key]:-} ]] || echo "  Working: $name"
      reported[$key]=1
    else
      missing+=("$name")
    fi
  done
  (( ${#missing[@]} == 0 )) && break
  waiting_for=$(IFS=,; echo "${missing[*]}" | sed 's/,/, /g')
  if (( SECONDS - started >= next_report )); then
    echo "  Still waiting for $waiting_for (waited $(( (SECONDS - started) / 60 )) min so far)"
    next_report=$(( next_report + 60 ))
  fi
  if [[ $up == *" map "* && $up == *" pbap "* ]] && (( SECONDS - last_fix >= 60 )); then
    echo "  Reconnecting the iPhone to bring up $waiting_for..."
    [[ $up == *" ancs "* ]] || enable_notifications
    connect_classic
    last_fix=$SECONDS
  fi
  sleep 5
done

echo -e "\nEverything works: messages, contacts, per-app notifications, calls and media controls."
echo "The iPhone daemon runs confined by its AppArmor profile."
action "Open iPhone from the app launcher."
