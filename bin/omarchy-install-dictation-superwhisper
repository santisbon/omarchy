#!/bin/bash

# omarchy:summary=Install and configure Superwhisper dictation
# omarchy:requires-sudo=true

set -e

# The package downloads Superwhisper from its vendor, so this asks first. Omarchy preinstalls it
# (the distro's docs/6).
if ! gum confirm --affirmative "$(omarchy-i18n common.yes)" --negative "$(omarchy-i18n common.no)" "$(omarchy-i18n dictation.installSuperwhisper)"; then
  exit 0
fi

omarchy-pkg-add superwhisper-bin
bash /usr/share/superwhisper/setup-user
# Existing profiles may still use Right Alt, which conflicts with Omarchy.
# Keep a recording shortcut active while moving away from that binding.
shortcuts=$(superwhisper shortcuts show)
if [[ $(jq -r '.shortcuts.hold' <<< "$shortcuts") == "RightAlt" ]]; then
  if [[ -z $(jq -r '.shortcuts.toggle' <<< "$shortcuts") ]]; then
    superwhisper shortcuts set hold "RightSuper" >/dev/null
  else
    superwhisper shortcuts set hold none >/dev/null
  fi
fi
# Superwhisper requires a native recording shortcut; keep it separate from
# Omarchy's recording key (Alt + Space).
superwhisper shortcuts set toggle "Ctrl+Alt+Space" >/dev/null
superwhisper shortcuts set hold none >/dev/null
omarchy-dictation-use superwhisper
omarchy-restart-hyprctl
omarchy-notification-send -g  "$(omarchy-i18n dictation.superwhisperReady)" "$(omarchy-i18n dictation.hint)" -t 10000
superwhisper settings
