#!/bin/bash

# omarchy:summary=Remove Lutris, Wine, and all their configs and caches.
# omarchy:requires-sudo=true

set -e

omarchy-pkg-drop lutris wine wine32:i386 wine64 winetricks python3-protobuf

rm -rf \
  "$HOME/.config/lutris" \
  "$HOME/.local/share/lutris" \
  "$HOME/.cache/lutris" \
  "$HOME/.wine" \
  "$HOME/.cache/wine" \
  "$HOME/.cache/winetricks"

echo ""
echo "Lutris, Wine, and their configs have been removed."
