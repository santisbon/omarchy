#!/bin/bash

# omarchy:summary=Install a supported browser
# omarchy:args=<chromium|chrome|brave-origin|firefox>
# omarchy:examples=omarchy install browser firefox | omarchy install browser chromium
# omarchy:requires-sudo=true

# Ubuntu's archive carries firefox and chromium only as placeholders that pull
# in snapd, and the distro pins snapd out. Firefox comes from Mozilla's own apt
# repository and Brave Origin from Brave's; Chromium has no vendor repository
# for Ubuntu, so it comes from the xtradeb PPA on Launchpad, a community build
# of upstream Chromium for each Ubuntu series, pinned below Ubuntu's archive so
# that only packages the archive lacks come from it. Every URL below answered
# on 2026-10-10.

source "$OMARCHY_PATH/install/helpers/browser-policy.sh"

setup_chromium_policy_directory() {
  browser_policy_setup_dir "$1"
}

announce_browser_installed() {
  echo ""
  echo "$1 browser installed. Make it the default via Setup > Defaults > Browser."
}

# Seed Chromium's first run: follow system appearance ("device") instead of dark,
# and skip the terms-of-service dialog Chromium 151 turned on by default. Written
# here, when a Chromium-based browser is installed, not at system install time.
seed_chromium_initial_preferences() {
  sudo mkdir -p /usr/lib/chromium
  echo '{"distribution":{"require_eula":false},"browser":{"theme":{"color_scheme":0,"color_scheme2":0}}}' |
    sudo tee /usr/lib/chromium/initial_preferences >/dev/null
}

copy_chromium_flags() {
  mkdir -p ~/.config
  cp -f "$OMARCHY_PATH/config/chromium-flags.conf" "$1"
  omarchy-install-chromium-copy-url
  seed_chromium_initial_preferences
}

setup_firefox_wayland() {
  mkdir -p ~/.config/environment.d
  echo "MOZ_ENABLE_WAYLAND=1" > ~/.config/environment.d/omarchy-firefox-wayland.conf
}


# Google publishes no repository to add first: the deb itself writes
# /etc/apt/sources.list.d/google-chrome.list and its key on install, and apt
# keeps Chrome current from there.
install_chrome_deb() {
  local tmp status
  tmp=$(mktemp -d)
  # apt downloads as the _apt user, which cannot read a 0700 mktemp directory.
  chmod 755 "$tmp"

  curl -fsSL --retry 3 \
    https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
    -o "$tmp/google-chrome-stable.deb" || { rm -rf "$tmp"; return 1; }
  chmod 644 "$tmp/google-chrome-stable.deb"

  # A path with a slash makes apt-get treat the argument as a local deb and
  # resolve its dependencies from the archive, which dpkg -i alone would not.
  sudo apt-get install -y "$tmp/google-chrome-stable.deb"
  status=$?
  rm -rf "$tmp"
  (( status == 0 )) && omarchy-pkg-present google-chrome-stable
}

case $1 in
chrome)
  echo "Installing Chrome..."
  install_chrome_deb || exit 1

  setup_chromium_policy_directory /etc/opt/chrome/policies/managed
  copy_chromium_flags ~/.config/chrome-flags.conf
  omarchy-theme-set-browser
  announce_browser_installed "Chrome"
  ;;
chromium)
  echo "Installing Chromium..."
  # xtradeb's PPA (Launchpad: ~xtradeb/+archive/ubuntu/apps, signing key
  # 5301FA4FD93244FBC6F6149982BB6851C64F6880, fetched from Ubuntu's keyserver).
  # The pin keeps Ubuntu's archive ahead for every package both carry.
  codename=$(. /etc/os-release && echo "$VERSION_CODENAME")
  omarchy-pkg-repo-add xtradeb \
    'https://keyserver.ubuntu.com/pks/lookup?op=get&search=0x5301FA4FD93244FBC6F6149982BB6851C64F6880' \
    https://ppa.launchpadcontent.net/xtradeb/apps/ubuntu "$codename" main amd64 --pin 400 || exit 1
  omarchy-pkg-add chromium || exit 1
  setup_chromium_policy_directory /etc/chromium/policies/managed
  copy_chromium_flags ~/.config/chromium-flags.conf
  omarchy-theme-set-browser
  announce_browser_installed "Chromium"
  ;;
brave-origin)
  echo "Installing Brave Origin..."
  # Brave's one apt repository carries brave-browser and brave-origin. The
  # source is named brave-origin because the package's own postinst writes
  # /etc/apt/sources.list.d/brave-origin.sources when it finds none; sharing
  # the name means there is one file either way.
  omarchy-pkg-repo-add brave-origin \
    https://brave-browser-apt-release.s3.brave.com/brave-browser-archive-keyring.gpg \
    https://brave-browser-apt-release.s3.brave.com stable main amd64 || exit 1
  omarchy-pkg-add brave-origin || exit 1
  setup_chromium_policy_directory /etc/brave/policies/managed
  copy_chromium_flags ~/.config/brave-flags.conf
  omarchy-theme-set-browser
  announce_browser_installed "Brave Origin"
  ;;
firefox)
  echo "Installing Firefox..."
  # The archive's firefox is the snap placeholder, so Mozilla's repository is
  # pinned above it; without the pin apt would pick the archive's higher
  # epoch and install the placeholder.
  omarchy-pkg-repo-add mozilla \
    https://packages.mozilla.org/apt/repo-signing-key.gpg \
    https://packages.mozilla.org/apt mozilla main --pin 1000 || exit 1
  omarchy-pkg-add firefox || exit 1

  # Mozilla's deb installs under /usr/lib/firefox.
  browser_policy_setup_firefox_distribution /usr/lib/firefox/distribution
  setup_firefox_wayland
  announce_browser_installed "Firefox"
  ;;
*)
  echo "Usage: omarchy-install-browser <chromium|chrome|brave-origin|firefox>"
  exit 1
  ;;
esac
