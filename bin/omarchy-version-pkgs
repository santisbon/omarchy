#!/bin/bash

# omarchy:summary=Print when system packages were last upgraded

# /var/log/apt/history.log holds one stanza per apt run, closed by an End-Date
# line, so the last End-Date is the most recent package change. logrotate moves
# the file aside monthly; right after that the current log is empty and the
# newest rotated copy has the answer.
last_run=$(grep '^End-Date:' /var/log/apt/history.log 2>/dev/null | tail -1)
if [[ -z $last_run && -f /var/log/apt/history.log.1.gz ]]; then
  last_run=$(zcat /var/log/apt/history.log.1.gz | grep '^End-Date:' | tail -1)
fi

if [[ -z $last_run ]]; then
  echo "unknown"
  exit 1
fi

date -d "${last_run#End-Date: }" "+%A, %B %d %Y at %H:%M"
