#!/bin/bash

# omarchy:summary=Remove Voxtype dictation
# omarchy:requires-sudo=true

set -e

if omarchy-cmd-present voxtype; then
  echo "Uninstall Voxtype to remove dictation."

  # Remove services: the unit voxtype setup systemd wrote and the GPU drop-in
  # omarchy-voxtype-install wrote
  systemctl --user disable --now voxtype.service 2>/dev/null || true
  rm -rf ~/.config/systemd/user/voxtype.service ~/.config/systemd/user/voxtype.service.d
  systemctl --user daemon-reload

  # Remove packages and configs
  omarchy-pkg-drop voxtype
  rm -rf ~/.config/voxtype
  rm -rf ~/.local/share/voxtype
  hyprctl reload >/dev/null
  omarchy-restart-shell
else
  echo "Voxtype was not installed."
fi
