#!/bin/bash

# omarchy:summary=Install Signal and launch it.
# omarchy:requires-sudo=true

set -e

echo "Installing Signal..."

# Signal publishes one suite, still named xenial, for every Debian and Ubuntu
# release. HEAD 200 on 2026-10-10 for the key and dists/xenial/InRelease.
omarchy-pkg-repo-add signal \
  https://updates.signal.org/desktop/apt/keys.asc \
  https://updates.signal.org/desktop/apt xenial main amd64
omarchy-pkg-add signal-desktop

echo "Opening Signal..."
setsid uwsm-app -- /usr/bin/signal-desktop >/dev/null 2>&1 &

echo ""
echo "Signal has been installed."
