#!/bin/bash

# omarchy:summary=Install Sublime Text from its vendor repository
# omarchy:requires-sudo=true

echo "Installing Sublime Text..."

# Sublime HQ's apt repository is a flat one: the suite is apt/stable/ and there
# are no components. HEAD 200 on 2026-10-10 for the key and
# apt/stable/InRelease.
omarchy-pkg-repo-add sublime-text \
  https://download.sublimetext.com/sublimehq-pub.gpg \
  https://download.sublimetext.com/ apt/stable/ "" amd64 || exit 1
omarchy-pkg-add sublime-text || exit 1

setsid uwsm-app -- gtk-launch sublime_text >/dev/null 2>&1 &
