#!/bin/bash

# omarchy:summary=Install Emacs from the Ubuntu archive
# omarchy:requires-sudo=true

echo "Installing Emacs..."

# emacs is a metapackage whose first alternative is emacs-gtk, the X11 build.
# emacs-pgtk is the build that talks to Wayland directly; naming it first makes
# the metapackage's dependency resolve to it. Both are in stonking's universe.
omarchy-pkg-add emacs-pgtk emacs || exit 1

setsid uwsm-app -- gtk-launch emacs >/dev/null 2>&1 &
