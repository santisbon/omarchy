#!/bin/bash

# omarchy:summary=Install the 32-bit graphics drivers that 32-bit games need (Steam, Lutris)
# omarchy:hidden=true
# omarchy:requires-sudo=true

# 32-bit games, and 32-bit Windows games through Proton or Wine, load 32-bit OpenGL and Vulkan
# drivers. Ubuntu's packages only recommend them (steam-libs recommends mesa-vulkan-drivers and
# libegl1; nvidia-driver-<branch> recommends libnvidia-gl-<branch>:i386), and this distro's apt
# installs no Recommends, so they are named here: Mesa's for the Intel or AMD GPU, and NVIDIA's
# for the installed NVIDIA driver branch, when there is one. Needs the i386 architecture enabled.
set -e

packages=(mesa-vulkan-drivers:i386 libegl1:i386 libgl1-mesa-dri:i386)
branch=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'nvidia-driver-[0-9]*' 2>/dev/null |
  awk '$1 == "ii" { sub(/^nvidia-driver-/, "", $2); sub(/-.*/, "", $2); print $2; exit }')
[[ -n $branch ]] && packages+=("libnvidia-gl-$branch:i386")

echo "Installing 32-bit graphics drivers: ${packages[*]}"
omarchy-pkg-add "${packages[@]}"
