#!/bin/bash

# omarchy:summary=Remove Steam and all of its game libraries, configs, and caches.
# omarchy:requires-sudo=true

set -e

# --autoremove inside omarchy-pkg-drop takes steam-libs and steam-libs-i386
# with the installer package. The i386 architecture stays enabled: other
# 32-bit packages may rely on it by now.
omarchy-pkg-drop steam-installer

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
