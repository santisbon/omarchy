#!/bin/bash

# omarchy:summary=Install Lutris with Wine for running Windows games (Battle.net, EA, Ubisoft Connect, etc.)
# omarchy:requires-sudo=true

set -e

echo "Installing Lutris..."

# Most Windows games are 32-bit or carry 32-bit pieces, and Ubuntu's wine32 is
# built for i386 only (the wine metapackage lists "wine64 | wine32" as its
# dependency, and wine32 is absent from the amd64 index), so the i386
# architecture is enabled the same way the Steam installer does it.
if ! dpkg --print-foreign-architectures | grep -qx i386; then
  echo "Enabling 32-bit packages for Wine..."
  sudo dpkg --add-architecture i386
  sudo apt-get update
fi

# lutris is in multiverse; wine, winetricks and python3-protobuf are its
# Recommends and are named here because omarchy-pkg-add skips Recommends.
# umu-launcher has no Ubuntu package; Lutris downloads its own runners.
omarchy-pkg-add lutris wine wine32:i386 winetricks python3-protobuf
omarchy-install-32bit-graphics

# Ubuntu's /usr/games/lutris already starts with #!/usr/bin/python3 (Debian
# policy forbids env in packaged shebangs), so mise's Python never shadows it.

cat <<'MSG'

Lutris will open and auto-fetch its DXVK and VKD3D runtimes in the background
(watch the bottom status bar). Once that finishes, click the + to add or install games.

MSG

setsid lutris >/dev/null 2>&1 &
