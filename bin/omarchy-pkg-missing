#!/bin/bash

# omarchy:summary=Returns true if any of the named packages are missing from the system (or false if they're all there).
# omarchy:args=<packages...>

# dpkg-query exits non-zero for a package it has never heard of and prints
# "not-installed" or "config-files" for one that is known but gone, so only the
# literal "installed" counts.
for pkg in "$@"; do
  if [[ $(dpkg-query -W -f='${db:Status-Status}' "$pkg" 2>/dev/null) != "installed" ]]; then
    exit 0
  fi
done

exit 1
