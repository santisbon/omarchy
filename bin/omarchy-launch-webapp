#!/bin/bash

# omarchy:summary=Launch a URL as a web app in the default supported browser
# omarchy:args=<url>

# A web app opens in a Chromium-family browser's app mode (--app). The default browser is used
# when it is one; otherwise the first installed Chromium-family browser in the list below. Omarchy
# always has Chromium, so it fell back to chromium.desktop unconditionally; this distro installs
# no browser by default, and with only Firefox (or none) that fallback ran an empty command.
# When no Chromium-family browser is installed, a notification says how to get one.
#
# Exec= comes from the same data dirs omarchy-cmd-default-browser searched, so a browser it
# resolved is one this can start.
IFS=: read -ra data_dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
exec_of() {
  local data_dir
  for data_dir in "${data_dirs[@]}"; do
    [[ -f $data_dir/applications/$1 ]] || continue
    sed -n 's/^Exec=\([^ ]*\).*/\1/p' "$data_dir/applications/$1" | head -1
    return
  done
}

browser=$(omarchy-cmd-default-browser)
case $browser in
chromium* | google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
*) browser="" ;;
esac
if [[ -z $browser || -z $(exec_of "$browser") ]]; then
  browser=""
  for candidate in chromium.desktop google-chrome.desktop brave-origin.desktop brave-browser.desktop microsoft-edge.desktop vivaldi-stable.desktop; do
    if [[ -n $(exec_of "$candidate") ]]; then
      browser=$candidate
      break
    fi
  done
fi
if [[ -z $browser ]]; then
  echo "omarchy-launch-webapp: web apps need a Chromium-based browser; install Chromium with 'omarchy install browser chromium'" >&2
  omarchy-notification-send -u critical -g 󰖟 "$(omarchy-i18n browser.webappNeedsChromium)" "$(omarchy-i18n browser.webappNeedsChromiumHint)"
  exit 1
fi

browser_exec=$(exec_of "$browser")

if ! omarchy-cmd-browser-handoff "$browser_exec" --app="$1" "${@:2}"; then
  exec setsid uwsm-app -- $browser_exec --app="$1" "${@:2}"
fi
