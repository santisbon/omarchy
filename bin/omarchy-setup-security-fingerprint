#!/bin/bash

# omarchy:summary=Set up fingerprint authentication for sudo, polkit, and lock screen
# omarchy:requires-sudo=true

set -e

# Ubuntu manages the common-* PAM stacks with pam-auth-update, which sudo,
# polkit, SDDM and this desktop's lock screen all include, so no PAM file is
# edited by hand here. The profile enabled is the desktop's own
# (/usr/share/pam-configs/omarchy-fprintd, from default/pam-configs/): Ubuntu's
# fprintd profile (pam_fprintd.so max-tries=1 timeout=10) with Omarchy's
# clamshell gate in front of it, a pam_exec of omarchy-hw-laptop-closed that
# skips the reader (success=1) when the lid is shut, so a docked, closed laptop
# goes straight to the password instead of waiting 10 seconds on a reader
# nobody can touch. The two profiles conflict, so Ubuntu's is disabled first
# (systems set up before the gate came back have it enabled).
setup_pam_config() {
  echo "Enabling the fingerprint PAM profile (pam-auth-update --enable omarchy-fprintd)..."
  sudo pam-auth-update --package --disable fprintd
  sudo pam-auth-update --package --enable omarchy-fprintd
}
setup_lock_fingerprint_pam() {
  echo "Configuring lock screen for fingerprint authentication..."
  sudo tee /etc/pam.d/omarchy-lock-fingerprint >/dev/null <<'EOF'
#%PAM-1.0
auth       required                    pam_fprintd.so
account    include                     common-account
EOF
}


echo -e "\e[32mSetting up fingerprint scanner for authentication.\n\e[0m"

# Bail before touching anything if there's no reader to talk to.
if ! omarchy-hw-fingerprint; then
  echo -e "\e[31mNo fingerprint sensor detected.\e[0m"
  exit 1
fi

# fprintd, libpam-fprintd and usbutils are part of the distro's base install
# (policy decided 2026-10-09), so this script never installs packages. A
# missing fprintd-enroll means the image is broken, not that setup is needed.
if omarchy-cmd-missing fprintd-enroll; then
  echo -e "\e[31mfprintd is not installed; the distro image should always ship it.\e[0m"
  exit 1
fi

# Enroll first fingerprint
echo -e "\e[32m\nLet's setup your right index finger as the first fingerprint.\e[0m"
echo -e "Keep moving the finger around on sensor until the process completes.\n"

if sudo fprintd-enroll "$USER"; then
  echo -e "\e[32m\nFingerprint enrolled successfully!\e[0m"

  # Verify
  echo -e "\nNow let's verify that it's working correctly.\n"
  if fprintd-verify; then
    # PAM comes last, once a print is enrolled and verified. Detection only
    # proves a reader is there, not that libfprint can drive it — an Elan MOC
    # sensor outside the elanmoc table gets this far and then fails to enroll.
    # Editing the stacks up front would leave those machines pointing at
    # pam_fprintd with nothing to match.
    setup_pam_config
    setup_lock_fingerprint_pam
    echo -e "\e[32m\nPerfect! Fingerprint authentication is now configured.\e[0m"
    echo "You can use your fingerprint for sudo, polkit, and lock screen (Super + Ctrl + L)."
  else
    echo -e "\e[31m\nVerification failed. You may want to try enrolling again.\e[0m"
  fi
else
  echo -e "\e[31m\nEnrollment failed. Please try again.\e[0m"
  exit 1
fi
