#!/bin/bash

# omarchy:summary=Update system packages with apt
# omarchy:requires-sudo=true

set -e

echo -e "\e[32m\nUpdate system packages\e[0m"

sudo apt-get update

# full-upgrade rather than upgrade: a new kernel or a package whose dependencies
# changed is held back by plain upgrade and would sit there release after release.
#
# Under -y nobody is at the terminal, so dpkg's conffile question (keep the
# local copy or take the package's) gets the answer that keeps the local copy;
# confdef takes the package's default only where the file was never edited.
dpkg_opts=()
if [[ ${OMARCHY_UPDATE_UNATTENDED:-} == 1 ]]; then
  dpkg_opts=(-o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
fi

sudo apt-get -y "${dpkg_opts[@]}" full-upgrade
