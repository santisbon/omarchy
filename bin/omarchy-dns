#!/bin/bash
# omarchy:summary=Show or configure the DNS servers of the NetworkManager connections
# omarchy:args=[Cloudflare|Google|DHCP|Custom]
# omarchy:examples=omarchy dns | omarchy dns Cloudflare | omarchy dns Custom
set -euo pipefail

# Ubuntu's way to set DNS is per connection, in NetworkManager, and a choice
# made here also has to reach networks joined later. So the servers go two
# places: every existing Wi-Fi and Ethernet profile (with DNS over TLS through the
# profile's dns-over-tls property, which NetworkManager hands to resolved), and
# NetworkManager's global DNS configuration, which overrides the DNS of every
# connection, present and future. The profiles are changed with nmcli as the
# calling user: network-manager's polkit rule
# (/usr/share/polkit-1/rules.d/org.freedesktop.NetworkManager.rules) lets a local,
# active member of the sudo or netdev group modify system connections without a
# password. The global configuration is NetworkManager's GlobalDnsConfiguration
# D-Bus property (kept in /var/lib/NetworkManager/NetworkManager-intern.conf),
# set with busctl; its polkit action (settings.modify.global-dns,
# auth_admin_keep) asks once, through the desktop's polkit agent. So there is
# no sudoers rule and no root half. Omarchy on Arch wrote a global-dns drop-in
# in /etc/NetworkManager/conf.d and overwrote systemd-resolved's resolved.conf;
# neither is done here. A network joined later gets the servers but not DNS
# over TLS, which global DNS cannot carry.

NM_BUS=(org.freedesktop.NetworkManager /org/freedesktop/NetworkManager org.freedesktop.NetworkManager)

provider_from_arg() {
  case "${1:-}" in
  Cloudflare | cloudflare) echo "Cloudflare" ;;
  Google | google) echo "Google" ;;
  DHCP | dhcp) echo "DHCP" ;;
  Custom | custom) echo "Custom" ;;
  *) return 1 ;;
  esac
}

dns_connection() {
  case "$1" in
  802-11-wireless | 802-3-ethernet) return 0 ;;
  *) return 1 ;;
  esac
}

# The servers of NetworkManager's global DNS configuration, comma separated,
# empty when there is none. busctl prints the property as
# a{sv} 1 "domains" a{sv} 1 "*" a{sv} 1 "servers" as 2 "1.1.1.1" "1.0.0.1".
global_dns() {
  busctl get-property "${NM_BUS[@]}" GlobalDnsConfiguration 2>/dev/null |
    sed -n 's/.*"servers" as [0-9]* //p' | tr -d '"' | tr ' ' ','
}

# set_global_dns <server>...: the global DNS servers for every domain; no
# servers clears the global configuration, so each profile's own DNS applies.
set_global_dns() {
  if (( $# == 0 )); then
    busctl --allow-interactive-authorization=yes set-property "${NM_BUS[@]}" GlobalDnsConfiguration 'a{sv}' 0
  else
    busctl --allow-interactive-authorization=yes set-property "${NM_BUS[@]}" GlobalDnsConfiguration \
      'a{sv}' 1 domains 'a{sv}' 1 '*' 'a{sv}' 1 servers as $# "$@"
  fi
}

# The DNS servers in use: the global configuration's, else those of the first
# active Wi-Fi or Ethernet connection, as nmcli prints ipv4.dns and ipv6.dns
# (comma separated); empty when DHCP's are in use.
current_dns() {
  local uuid type global
  global=$(global_dns)
  if [[ -n $global ]]; then
    echo "$global"
    return 0
  fi
  while IFS=: read -r uuid type; do
    [[ -n $uuid ]] || continue
    dns_connection "$type" || continue
    if [[ $(nmcli -g ipv4.ignore-auto-dns connection show "$uuid") == yes ]]; then
      nmcli -g ipv4.dns,ipv6.dns connection show "$uuid" | paste -sd,
    fi
    return 0
  done < <(nmcli -t -f UUID,TYPE connection show --active)
}

current_dns_provider() {
  local dns
  dns=$(current_dns || true)
  if [[ -z ${dns//,/} ]]; then
    echo "DHCP"
  elif [[ $dns == *"1.1.1.1"* || $dns == *"2606:4700:4700::1111"* ]]; then
    echo "Cloudflare"
  elif [[ $dns == *"8.8.8.8"* || $dns == *"2001:4860:4860::8888"* ]]; then
    echo "Google"
  else
    echo "Custom"
  fi
}

normalize_servers() {
  printf '%s\n' "$*" | tr ',\t\n' ' ' | xargs | tr ' ' ','
}

split_dns_servers() {
  local server
  ipv4_dns=""
  ipv6_dns=""
  for server in ${1//,/ }; do
    [[ -n $server ]] || continue
    if [[ $server == *:* ]]; then
      ipv6_dns+="${ipv6_dns:+ }$server"
    else
      ipv4_dns+="${ipv4_dns:+ }$server"
    fi
  done
}

# set_connection_dns <ipv4 servers> <ipv6 servers> <dns-over-tls>: every Wi-Fi and
# Ethernet profile gets the servers instead of DHCP's. Empty servers with
# dns-over-tls "default" puts the profiles back to DHCP.
set_connection_dns() {
  local ipv4_dns=$1 ipv6_dns=$2 dot=$3 ignore=yes uuid type
  [[ -n $ipv4_dns$ipv6_dns ]] || ignore=no
  while IFS=: read -r uuid type; do
    [[ -n $uuid ]] || continue
    dns_connection "$type" || continue
    nmcli connection modify "$uuid" \
      ipv4.ignore-auto-dns "$ignore" ipv4.dns "$ipv4_dns" \
      ipv6.ignore-auto-dns "$ignore" ipv6.dns "$ipv6_dns" \
      connection.dns-over-tls "$dot" >/dev/null
  done < <(nmcli -t -f UUID,TYPE connection show)
}

reapply_active_connections() {
  local device type state
  while IFS=: read -r device type state; do
    [[ -n $device && $state == connected ]] || continue
    case "$type" in
    wifi | ethernet) nmcli device reapply "$device" >/dev/null 2>&1 || true ;;
    esac
  done < <(nmcli -t -f DEVICE,TYPE,STATE device status)
}

usage() {
  echo "Usage: omarchy-dns [Cloudflare|Google|DHCP|Custom]" >&2
}

if (( $# == 0 )); then
  current_dns_provider
  exit 0
fi
if (( $# > 1 )) || ! provider=$(provider_from_arg "$1"); then
  usage
  exit 1
fi

case "$provider" in
Cloudflare)
  set_global_dns 1.1.1.1 1.0.0.1 2606:4700:4700::1111 2606:4700:4700::1001
  set_connection_dns "1.1.1.1 1.0.0.1" "2606:4700:4700::1111 2606:4700:4700::1001" opportunistic
  ;;
Google)
  set_global_dns 8.8.8.8 8.8.4.4 2001:4860:4860::8888 2001:4860:4860::8844
  set_connection_dns "8.8.8.8 8.8.4.4" "2001:4860:4860::8888 2001:4860:4860::8844" opportunistic
  ;;
DHCP)
  set_global_dns
  set_connection_dns "" "" default
  ;;
Custom)
  echo "Enter your DNS servers (space-separated, e.g. '192.168.1.1 1.1.1.1'):"
  read -r dns_servers || dns_servers=""
  dns_servers=$(normalize_servers "$dns_servers")
  if [[ -z $dns_servers ]]; then
    echo "Error: No DNS servers provided." >&2
    exit 1
  fi
  split_dns_servers "$dns_servers"
  # shellcheck disable=SC2086 # one argument per server
  set_global_dns ${dns_servers//,/ }
  set_connection_dns "$ipv4_dns" "$ipv6_dns" default
  ;;
esac
reapply_active_connections
