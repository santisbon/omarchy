#!/bin/bash

# omarchy:summary=Reinstall all default Omarchy packages
# omarchy:requires-sudo=true

set -e

sudo apt-get update

# The desktop meta package depends on everything in omarchy-base.packages, so
# installing it brings back whatever was removed.
sudo apt-get install -y --no-install-recommends omarchy-desktop

# --reinstall then puts every listed package's files back on disk, which the
# meta package alone would not do for one that is installed but damaged.
mapfile -t packages < <(grep -v '^#' "$OMARCHY_PATH/install/omarchy-base.packages" | grep -v '^$' | awk '{ print $1 }')
sudo apt-get install -y --no-install-recommends --reinstall "${packages[@]}"
