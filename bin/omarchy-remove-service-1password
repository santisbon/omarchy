#!/bin/bash

# omarchy:summary=Remove 1Password, its CLI and its Chromium extension.
# omarchy:requires-sudo=true

EXTENSION_ID="aeblfdkhhhdcdjpifhhbdiojplfjncoa"
EXTENSION_FILE="/usr/share/chromium/extensions/$EXTENSION_ID.json"

sudo rm -f "$EXTENSION_FILE"
omarchy-pkg-drop 1password 1password-cli
# 1Password's deb may have written its own one-line source as well.
sudo rm -f /etc/apt/sources.list.d/1password.list
omarchy-pkg-repo-remove 1password

echo ""
echo "1Password has been removed."
