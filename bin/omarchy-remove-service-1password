#!/bin/bash

# omarchy:summary=Remove 1Password and its CLI.
# omarchy:requires-sudo=true

omarchy-pkg-drop 1password 1password-cli
# 1Password's deb may have written its own one-line source as well.
sudo rm -f /etc/apt/sources.list.d/1password.list
omarchy-pkg-repo-remove 1password

echo ""
echo "1Password has been removed."
