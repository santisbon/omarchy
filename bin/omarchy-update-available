#!/bin/bash

# omarchy:summary=Check whether Omarchy updates are available.

set -euo pipefail

updates=()

if [[ $OMARCHY_PATH != "/usr/share/omarchy" ]]; then
  upstream=$(git -C "$OMARCHY_PATH" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
  if [[ -n $upstream ]]; then
    GIT_TERMINAL_PROMPT=0 timeout 10 git -C "$OMARCHY_PATH" fetch --quiet 2>/dev/null || true

    behind=$(git -C "$OMARCHY_PATH" rev-list --count "HEAD..$upstream" 2>/dev/null || echo 0)
    if (( behind > 0 )); then
      commit_label=commits
      (( behind == 1 )) && commit_label=commit
      updates+=("omarchy-dev-checkout $behind new $commit_label on $upstream")
    fi
  fi
fi

# The apt-daily timer refreshes the package lists on its own, so this reads
# them as they are: no apt-get update, and therefore no sudo, from a bar
# widget. apt list prints one line per package in the form
#   name/suite new-version arch [upgradable from: old-version]
# and the distro's own packages all share the omarchy- prefix. The line is
# reshaped to "name old -> new", the shape Omarchy printed before.
mapfile -t package_updates < <(
  apt list --upgradable 2>/dev/null |
    awk -F'[/ ]' '$1 ~ /^omarchy-/ {
      old = $0; sub(/.*upgradable from: /, "", old); sub(/\].*/, "", old)
      print $1, old, "->", $3
    }' || true
)

if (( ${#package_updates[@]} > 0 )); then
  updates+=("${package_updates[@]}")
fi

if (( ${#updates[@]} > 0 )); then
  printf '%s\n' "${updates[@]}"
  exit 0
else
  echo "Omarchy is up to date"
  exit 1
fi
