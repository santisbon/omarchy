#!/bin/bash

# omarchy:summary=Remove fingerprint authentication from sudo, polkit, and lock screen
# omarchy:requires-sudo=true

set -e


remove_pam_config() {
  # The setup enabled the desktop's omarchy-fprintd profile (Ubuntu's fprintd
  # profile on systems set up earlier); disabling both takes pam_fprintd back
  # out of common-auth for every service at once.
  echo "Disabling the fingerprint PAM profiles (pam-auth-update --disable omarchy-fprintd fprintd)..."
  sudo pam-auth-update --package --disable omarchy-fprintd fprintd
}
remove_lock_fingerprint_pam() {
  if [[ -f /etc/pam.d/omarchy-lock-fingerprint ]]; then
    echo "Removing lock screen fingerprint authentication..."
    sudo rm -f /etc/pam.d/omarchy-lock-fingerprint
  fi
}


echo -e "\e[32mRemoving fingerprint scanner from authentication.\n\e[0m"

remove_pam_config
remove_lock_fingerprint_pam

# fprintd and libpam-fprintd stay installed: they are part of the distro's base
# image, so only the PAM lines and the enrolled prints' use are removed here.
echo -e "\e[32mFingerprint authentication has been completely removed.\e[0m"
