#!/bin/bash

# omarchy:summary=Launch the default editor selected via Omarchy defaults.
# omarchy:args=[--inline] <path>

default_editor="$HOME/.local/state/omarchy/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="nano"
fi

# VSCodium comes from Flathub and has no codium command on PATH.
if [[ $editor == codium ]] && ! omarchy-cmd-present codium && flatpak info --system com.vscodium.codium &>/dev/null; then
  exec setsid uwsm-app -- flatpak run com.vscodium.codium "$@"
fi

# nano is the fallback and the default: the desktop's package list installs it (Ubuntu's
# ubuntu-standard only recommends it, and the image has no ubuntu-standard). Neovim is installed
# too, without Omarchy's configuration; Setup > Defaults > Editor picks it.
omarchy-cmd-present "$editor" || editor="nano"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" "$@"
  else
    exec omarchy-launch-tui "$editor" "$@"
  fi
  ;;
*)
  exec setsid uwsm-app -- "$editor" "$@"
  ;;
esac
