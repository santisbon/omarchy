#!/bin/bash

# omarchy:summary=Prune package files the archive no longer offers from apt's cache
# omarchy:requires-sudo=true

set -e

# autoclean removes only the .deb files in /var/cache/apt/archives that no
# configured source still carries, so the current version's file stays as the
# offline reinstall path.
echo -e "\e[32m\nPrune package cache\e[0m"
sudo apt-get autoclean || echo -e "\e[33mCould not prune the package cache.\e[0m" >&2
echo
