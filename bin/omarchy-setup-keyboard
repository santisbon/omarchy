#!/bin/bash

# omarchy:summary=Choose your keyboard layouts for Hyprland in a fuzzy-finder TUI, or set them directly.
# omarchy:args=[<layouts> [<variants> [<options>]] | --reset]
# omarchy:examples=omarchy setup keyboard | omarchy setup keyboard us,es | omarchy setup keyboard us,es , grp:ctrls_toggle | omarchy setup keyboard --reset

set -euo pipefail

# Hyprland's default input.lua reads this file over /etc/default/keyboard, for this user only.
gui_file="$HOME/.config/hypr/keyboard-gui.conf"
# xkb-data's list of layouts and variants, each with its English description.
rules="/usr/share/X11/xkb/rules/evdev.lst"

# The options the installer wrote (usually none), kept under any switching key chosen here.
system_options=$(sed -n 's/^XKBOPTIONS="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/default/keyboard 2>/dev/null || true)

write_layouts() {
  local layouts="$1" variants="$2" options="$3"

  if ! xkbcli compile-keymap --layout "$layouts" --variant "$variants" --options "$options" >/dev/null 2>&1; then
    echo "xkbcommon cannot build a keymap from layouts \"$layouts\", variants \"$variants\", options \"$options\"." >&2
    exit 1
  fi

  mkdir -p "${gui_file%/*}"
  cat >"$gui_file" <<EOF
# Written by Setup > Keyboard (omarchy-setup-keyboard). Run it again to change these layouts,
# or omarchy-setup-keyboard --reset to go back to the layout chosen at installation.
# Same format as /etc/default/keyboard; Hyprland reads it for this user only.
XKBLAYOUT="$layouts"
XKBVARIANT="$variants"
XKBOPTIONS="$options"
EOF
  hyprctl reload >/dev/null
}

reset_layouts() {
  rm -f "$gui_file"
  hyprctl reload >/dev/null
}

section() {
  awk -v name="! $1" '$0 == name { found = 1; next } /^!/ { found = 0 } found && NF' "$rules"
}

pick() {
  fzf --delimiter='\t' --with-nth=2 --header "$1" --height=100% --reverse \
    --color 'pointer:green,marker:green' | cut -f1
}

case "${1:-}" in
  --reset)
    reset_layouts
    exit 0
    ;;
  "")
    ;;
  *)
    write_layouts "$1" "${2:-}" "${3:-$system_options}"
    exit 0
    ;;
esac

layout_list=$(section layout | awk '{ code = $1; $1 = ""; sub(/^ +/, ""); printf "%s\t%s (%s)\n", code, $0, code }')

if [[ -f $gui_file ]]; then
  first_line=$'reset\tThe layout chosen at installation (removes your own layouts)'
else
  first_line=""
fi

layouts=()
variants=()
while :; do
  if (( ${#layouts[@]} == 0 )); then
    header="Your main layout: Hyprland matches keyboard shortcuts against it (Esc cancels)"
    choices=$( { [[ -n $first_line ]] && echo "$first_line"; echo "$layout_list"; } )
  else
    header="Add layout $(( ${#layouts[@]} + 1 )), after ${layouts[*]} (Esc when done)"
    choices=$(grep -v -E "^($(IFS='|'; echo "${layouts[*]}"))"$'\t' <<<"$layout_list")
  fi

  layout=$(pick "$header" <<<"$choices" || true)
  [[ -n $layout ]] || break

  if [[ $layout == "reset" ]]; then
    reset_layouts
    echo "Your keyboard uses the layout chosen at installation again."
    omarchy-show-done
    exit 0
  fi

  variant_list=$(section variant | awk -v layout="$layout:" '$2 == layout { code = $1; $1 = ""; $2 = ""; sub(/^ +/, ""); printf "%s\t%s\n", code, $0 }')
  variant=""
  if [[ -n $variant_list ]]; then
    variant=$( { printf '\t%s\n' "The standard $layout layout"; echo "$variant_list"; } | pick "Variant of $layout" || true)
  fi

  layouts+=("$layout")
  variants+=("$variant")
done

if (( ${#layouts[@]} == 0 )); then
  exit 0
fi

options="$system_options"
if (( ${#layouts[@]} > 1 )) && [[ $system_options != *grp:* ]]; then
  # Both keys were checked with xkbcli compile-keymap: grp:ctrls_toggle changes only the two
  # Ctrl keys, so AltGr and every other key stay as each layout has them. grp:alts_toggle, the
  # example in input.lua, would turn AltGr into a plain Right Alt on the other layouts.
  key=$(printf '%s\t%s\n' \
    "" "Click the layout in the top bar to switch (no key)" \
    "grp:ctrls_toggle" "Left Ctrl + Right Ctrl together, or click the top bar" |
    pick "How to switch layouts" || true)
  [[ -n $key ]] && options="${options:+$options,}$key"
fi

joined_layouts=$(IFS=,; echo "${layouts[*]}")
joined_variants=$(IFS=,; echo "${variants[*]}")
write_layouts "$joined_layouts" "$joined_variants" "$options"

echo "Your keyboard layouts are now: $joined_layouts"
if grep -q '^[[:space:]]*kb_layout' "$HOME/.config/hypr/input.lua" 2>/dev/null; then
  echo "~/.config/hypr/input.lua sets kb_layout too, and wins over these layouts: comment that line out to use them."
fi
omarchy-show-done
