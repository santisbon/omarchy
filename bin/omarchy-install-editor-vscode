#!/bin/bash

# omarchy:summary=Install VS Code and configure Omarchy defaults for secrets, updates, and theme
# omarchy:requires-sudo=true

echo "Installing VSCode..."

# Microsoft's repository (HEAD 200 on 2026-10-10 for both the key and
# repos/code/dists/stable/InRelease). The source is named vscode because the
# code package's own postinst writes /etc/apt/sources.list.d/vscode.sources
# when it finds none; sharing the name means there is one file either way.
omarchy-pkg-repo-add vscode \
  https://packages.microsoft.com/keys/microsoft.asc \
  https://packages.microsoft.com/repos/code stable main amd64 || exit 1

# libssl3t64: VS Code checks each extension's signature with vsce-sign, a .NET program that
# finds OpenSSL only as libssl.so.3 or older. Ubuntu 26.10's OpenSSL is 4 (libssl.so.4), so
# without OpenSSL 3 every signed extension install fails ("No usable version of libssl was found").
omarchy-pkg-add code libssl3t64 || exit 1

# Chromium's sandbox in VS Code creates user namespaces, which Ubuntu allows an unprivileged
# program only through an AppArmor profile: the apparmor package's /etc/apparmor.d/code (profile
# vscode, flags=(unconfined) with userns). Without it loaded, VS Code crashes at start. The
# package is reinstalled when its parser or that profile is missing, and the profile is loaded
# now, so VS Code starts before the next boot.
if [[ ! -x /usr/sbin/apparmor_parser || ! -f /etc/apparmor.d/code ]]; then
  sudo apt-get install -y --reinstall apparmor || exit 1
fi
sudo apparmor_parser -r /etc/apparmor.d/code || exit 1

# The snap the menu installed for two releases goes, so `code` is the .deb's. Settings and
# extensions stay: both installs keep them in ~/.config/Code and ~/.vscode.
if omarchy-pkg-snap-present code; then
  omarchy-pkg-snap-drop code || exit 1
fi

mkdir -p ~/.vscode ~/.config/Code/User

# Written only on a first install, so reinstalling keeps the user's files.
if [[ ! -f ~/.vscode/argv.json ]]; then
  cat > ~/.vscode/argv.json << 'ARGV'
// This configuration file allows you to pass permanent command line arguments to VS Code.
// Only a subset of arguments is currently supported to reduce the likelihood of breaking
// the installation.
//
// PLEASE DO NOT CHANGE WITHOUT UNDERSTANDING THE IMPACT
//
// NOTE: Changing this file requires a restart of VS Code.
{
  "password-store":"gnome-libsecret"
}
ARGV
fi

# Ensure VSC's own auto-update feature is turned off
if [[ ! -f ~/.config/Code/User/settings.json ]]; then
  printf '{\n  "update.mode": "none"\n}\n' > ~/.config/Code/User/settings.json
fi

# Apply Omarchy theme to VSCode
omarchy-theme-set-vscode

setsid uwsm-app -- gtk-launch code >/dev/null 2>&1 &
