#!/bin/bash

# omarchy:summary=Install VS Code and configure Omarchy defaults for secrets, updates, and theme
# omarchy:requires-sudo=true

echo "Installing VSCode..."

# Microsoft's snap (publisher vscode), classic confinement, so VS Code reads ~/.vscode and
# ~/.config/Code like any other install. Microsoft's .deb fails every signed extension install
# on this distro: its signature verifier, vsce-sign, is a .NET 9 program that finds OpenSSL only
# as libssl.so.3 or older, and Ubuntu 26.10 ships OpenSSL 4 (libssl.so.4). The snap's vsce-sign
# loads OpenSSL 1.1 from the core20 snap instead.
omarchy-pkg-snap-add code --classic || exit 1

# An earlier install from Microsoft's apt repository goes, with the repository, so `code` is the
# snap's. Settings and extensions stay: both installs keep them in ~/.config/Code and ~/.vscode.
if omarchy-pkg-present code; then
  omarchy-pkg-drop code || exit 1
fi
omarchy-pkg-repo-remove vscode || exit 1

mkdir -p ~/.vscode ~/.config/Code/User

# Written only on a first install, so switching an existing install keeps the user's files.
if [[ ! -f ~/.vscode/argv.json ]]; then
  cat > ~/.vscode/argv.json << 'ARGV'
// This configuration file allows you to pass permanent command line arguments to VS Code.
// Only a subset of arguments is currently supported to reduce the likelihood of breaking
// the installation.
//
// PLEASE DO NOT CHANGE WITHOUT UNDERSTANDING THE IMPACT
//
// NOTE: Changing this file requires a restart of VS Code.
{
  "password-store":"gnome-libsecret"
}
ARGV
fi

# Ensure VSC's own auto-update feature is turned off
if [[ ! -f ~/.config/Code/User/settings.json ]]; then
  printf '{\n  "update.mode": "none"\n}\n' > ~/.config/Code/User/settings.json
fi

# Apply Omarchy theme to VSCode
omarchy-theme-set-vscode

# The snap's desktop entry is code_code.desktop.
setsid uwsm-app -- gtk-launch code_code >/dev/null 2>&1 &
