#!/bin/bash

# omarchy:summary=Launch a desktop entry, on the NVIDIA GPU when it asks for one on a hybrid-graphics machine
# omarchy:args=[--print] <desktop-id>
# omarchy:examples=omarchy-launch-desktop org.gnome.Nautilus | omarchy-launch-desktop --print steam

# The application menu and launcher start applications through this (shell/services/
# AppLibrary.qml). It runs "uwsm-app -- gtk-launch <id>.desktop", as Omarchy does, except on
# hybrid graphics (the session sets OMARCHY_GPU_OFFLOAD=nvidia, and applications default to the
# display GPU's Mesa driver so starting one does not wake the NVIDIA GPU), where an application
# runs on the NVIDIA GPU through omarchy-launch-nvidia when:
#   - its desktop entry asks for the discrete GPU: PrefersNonDefaultGPU=true (the freedesktop
#     Desktop Entry key GNOME honors) or X-KDE-RunOnDiscreteGpu=true (KDE's); Steam's entry
#     sets both; or
#   - ~/.config/omarchy/nvidia-apps lists its desktop id (one per line, ".desktop" optional,
#     "#" starts a comment), for applications whose entry does not ask, such as Heroic or OBS.
# A line "-<id>" in that file keeps an application on the display GPU even if its entry asks.
# The offload variables are set inside the application's own unit (uwsm-app starts the command
# with the session's environment, not the caller's), and gtk-launch passes them to the program.
# --print prints the decision and the command instead of running it.
print=0
[[ ${1:-} == --print ]] && { print=1; shift; }
id=${1:?Usage: omarchy-launch-desktop [--print] <desktop-id>}
id=${id%.desktop}

entry=""
IFS=: read -ra dirs <<<"${XDG_DATA_HOME:-$HOME/.local/share}:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
for dir in "${dirs[@]}"; do
  [[ -f $dir/applications/$id.desktop ]] && { entry=$dir/applications/$id.desktop; break; }
done

on_nvidia=0
reason="the display GPU (not a hybrid-graphics session)"
if [[ ${OMARCHY_GPU_OFFLOAD:-} == nvidia ]]; then
  reason="the display GPU (its entry does not ask for the discrete GPU)"
  if [[ -n $entry ]] && sed -n '/^\[Desktop Entry\]/,/^\[/p' "$entry" | grep -qE '^(PrefersNonDefaultGPU|X-KDE-RunOnDiscreteGpu)=true'; then
    on_nvidia=1; reason="NVIDIA (its desktop entry asks for the discrete GPU)"
  fi
  list=${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/nvidia-apps
  if [[ -f $list ]]; then
    while IFS= read -r line; do
      line=${line%%#*}; line=${line//[[:space:]]/}; line=${line%.desktop}
      [[ -z $line ]] && continue
      if [[ $line == "$id" ]]; then on_nvidia=1; reason="NVIDIA (listed in $list)"; fi
      if [[ $line == "-$id" ]]; then on_nvidia=0; reason="the display GPU (kept there by $list)"; fi
    done <"$list"
  fi
fi

if (( on_nvidia )); then
  cmd=(uwsm-app -- omarchy-launch-nvidia gtk-launch "$id.desktop")
else
  cmd=(uwsm-app -- gtk-launch "$id.desktop")
fi
if (( print )); then
  echo "$id: ${entry:-no desktop entry found}"
  echo "runs on $reason"
  echo "command: ${cmd[*]}"
  exit 0
fi
exec "${cmd[@]}"
