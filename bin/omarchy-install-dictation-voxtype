#!/bin/bash

# omarchy:summary=Install and configure Voxtype dictation
# omarchy:requires-sudo=true

set -e

# Voxtype comes from this distro's apt repository (packages/voxtype in the distro's repository:
# Voxtype's own release package, without its ONNX GPU builds); Omarchy installs it from the AUR.
if omarchy-cmd-missing voxtype; then
  if gum confirm --affirmative "$(omarchy-i18n common.yes)" --negative "$(omarchy-i18n common.no)" "$(omarchy-i18n dictation.installVoxtype)"; then
    omarchy-pkg-add wtype voxtype
  else
    exit 0
  fi
fi

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
mkdir -p "$config_home/voxtype"
new_config=""
if [[ ! -e $config_home/voxtype/config.toml ]]; then
  cp "$OMARCHY_PATH/default/voxtype/config.toml" "$config_home/voxtype/"
  new_config=1
fi

# Setup reuses the configured model and downloads it only when missing.
# Retry these steps even when an earlier attempt already installed the binary.
voxtype setup --download --no-post-install

# GPU. Voxtype's own switch, voxtype setup gpu --enable, replaces /usr/bin/voxtype, a file
# the package owns: it needs root, and the next upgrade undoes it. The package's
# /usr/bin/voxtype runs the Vulkan build when VOXTYPE_GPU=1, so the choice goes into a
# drop-in for the user's voxtype service instead. VOXTYPE_VULKAN_DEVICE names the GPU by
# vendor (Voxtype narrows Vulkan's drivers to it): the discrete GPU, NVIDIA or AMD, when its
# Vulkan driver is installed, else the integrated one; with no Vulkan driver, the CPU builds.
# With two GPUs, gpu_isolation runs each transcription in a subprocess, so the discrete GPU
# can sleep between dictations.
dropin=~/.config/systemd/user/voxtype.service.d
rm -f "$dropin/omarchy-gpu.conf"
gpus=0 nvidia="" amd="" intel=""
for card in /sys/class/drm/card*; do
  [[ ${card##*/} =~ ^card[0-9]+$ ]] || continue
  gpus=$((gpus + 1))
  case $(cat "$card/device/vendor" 2>/dev/null) in
    0x10de) nvidia=1 ;;
    0x1002) amd=1 ;;
    0x8086) intel=1 ;;
  esac
done
icd() { compgen -G "/usr/share/vulkan/icd.d/$1" >/dev/null; }
device=""
if [[ -n $nvidia ]] && icd 'nvidia_icd*.json'; then
  device=nvidia
elif [[ -n $amd ]] && icd 'radeon_icd*.json'; then
  device=amd
elif [[ -n $intel ]] && icd 'intel_icd*.json'; then
  device=intel
fi
if [[ -n $device ]]; then
  mkdir -p "$dropin"
  printf '[Service]\nEnvironment=VOXTYPE_GPU=1\nEnvironment=VOXTYPE_VULKAN_DEVICE=%s\n' "$device" >"$dropin/omarchy-gpu.conf"
  if ((gpus > 1)); then
    [[ -z $new_config ]] || sed -i '/^\[whisper\]/a gpu_isolation = true' "$config_home/voxtype/config.toml"
  fi
  echo "Dictation runs on the GPU: $device$( ((gpus > 1)) && echo ', isolated so the GPU can sleep between dictations')."
else
  echo "Dictation runs on the CPU: no Vulkan driver for this machine's GPU."
fi

voxtype setup systemd
systemctl --user enable --now voxtype.service

omarchy-dictation-use voxtype
omarchy-restart-hyprctl
omarchy-notification-send -g  "$(omarchy-i18n dictation.voxtypeReady)" "$(omarchy-i18n dictation.hint)" -t 10000
