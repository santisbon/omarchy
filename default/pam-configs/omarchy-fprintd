Name: Fingerprint authentication, skipped while the laptop lid is closed (Omarchy)
Default: no
Priority: 260
Conflicts: fprintd
Auth-Type: Primary
Auth:
	[success=2 default=ignore]	pam_succeed_if.so quiet service notin sudo:sudo-i:polkit-1
	[success=1 default=ignore]	pam_exec.so quiet /usr/bin/omarchy-hw-laptop-closed
	[success=end default=ignore]	pam_fprintd.so max-tries=1 timeout=10
